# Database connection (PostgreSQL in Docker on port 5433 or standard 5432)
DATABASE_URL="postgresql://user:password@localhost:5433/database_name?schema=public"

# Auth Secrets
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
CUSTOMER_JWT_SECRET="change-me-customer-access-secret"
CUSTOMER_JWT_REFRESH_SECRET="change-me-customer-refresh-secret"

# Server Port
PORT=3001
