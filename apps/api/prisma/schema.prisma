// Migrations note (db push -> migrate transition):
// - 20260803083000_init is a FULL SCHEMA SNAPSHOT (baseline). On databases
//   previously created with `prisma db push` its SQL is already applied:
//   run `npm run prisma:migrate:pre-existing` (prisma migrate resolve
//   --applied 20260803083000_init, then prisma migrate deploy) instead of a
//   plain `prisma migrate deploy`.
// - The pre-existing script is idempotent: `resolve --applied` is expected to
//   fail on databases where the baseline is already registered, so its output
//   is suppressed and `migrate deploy` always runs (it only applies what is
//   pending). Do NOT chain it with `&&`, which would abort the deploy.
// - 20260803083233_combo-sale-rules adds sale/vigencia rules (modo_venta,
//   vigencia, cupo) on top of the baseline.
// - `prisma migrate dev` requires a TTY (fails in CI/scripts): use deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               BigInt    @id @default(autoincrement())
  public_id        String    @unique @default(uuid()) @db.Uuid
  rol_id           BigInt
  nombres          String    @db.VarChar(120)
  apellidos        String    @db.VarChar(120)
  email            String    @unique @db.VarChar(255)
  telefono         String?   @db.VarChar(30)
  password_hash    String    @db.Text
  codigo_referido  String?   @unique @db.VarChar(50)
  activo           Boolean   @default(true)
  ultimo_acceso_en DateTime?
  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt

  rol                   Rol                     @relation(fields: [rol_id], references: [id])
  MovimientosInventario MovimientosInventario[]
  Compra                Compra[]
  Venta                 Venta[]
  reservas_inventario   ReservaInventario[]
  ventas_aprobadas      VentaDetalle[]          @relation("VentaDetalleAprobadoPor")
  pedido_historiales    PedidoHistorialEstado[] @relation("PedidoHistorialCambiadoPorUsuario")
  devolucionesEvaluadas Devolucion[]            @relation("DevolucionEvaluadaPorUsuario")
  bitacoraEventos       Bitacora[]              @relation("BitacoraUsuario")
  cajas                 Caja[]                  @relation("CajaUsuario")
  movimientosCaja       MovimientoCaja[]        @relation("MovimientoCajaUsuario")
  gastosOperativos      GastoOperativo[]        @relation("GastoOperativoUsuario")
  pedidos_preparados    Pedido[]                @relation("PedidoPreparador")
  pedidos_repartidos    Pedido[]                @relation("PedidoRepartidor")

  @@map("usuarios")
}

model Rol {
  id             BigInt   @id @default(autoincrement())
  nombre         String   @unique @db.VarChar(50)
  descripcion    String?  @db.Text
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  codigo      String @id @db.VarChar(50) // ej: "iam:usuarios:crear"
  descripcion String @db.VarChar(255)

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rol_id         BigInt
  permiso_codigo String @db.VarChar(50)

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_codigo], references: [codigo], onDelete: Cascade)

  @@id([rol_id, permiso_codigo])
  @@map("roles_permisos")
}

model Bitacora {
  id               BigInt   @id @default(autoincrement())
  public_id        String   @unique @default(uuid()) @db.Uuid
  tipo_actor       String   @default("USUARIO") @db.VarChar(20)
  usuario_id       BigInt?
  cliente_id       BigInt?
  request_id       String?  @db.VarChar(100)
  ip               String?  @db.VarChar(50)
  user_agent       String?  @db.Text
  entidad          String   @db.VarChar(50)
  entidad_id       String?  @db.VarChar(50)
  operacion        String   @db.VarChar(50)
  datos_anteriores Json?    @db.JsonB
  datos_nuevos     Json?    @db.JsonB
  creado_en        DateTime @default(now())

  usuario Usuario? @relation("BitacoraUsuario", fields: [usuario_id], references: [id], onDelete: SetNull)
  cliente Cliente? @relation("BitacoraCliente", fields: [cliente_id], references: [id], onDelete: SetNull)

  @@index([entidad, entidad_id])
  @@index([usuario_id])
  @@index([cliente_id])
  @@index([creado_en])
  @@map("bitacora")
}

model Marca {
  id             BigInt   @id @default(autoincrement())
  nombre         String   @unique @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  descripcion    String?  @db.Text
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  productos Producto[]

  @@map("marcas")
}

model Categoria {
  id                  BigInt   @id @default(autoincrement())
  categoria_padre_id  BigInt?
  nombre              String   @db.VarChar(255)
  slug                String   @unique @db.VarChar(255)
  descripcion         String?  @db.Text
  plantilla_atributos Json?    @db.JsonB
  activo              Boolean  @default(true)
  creado_en           DateTime @default(now())
  actualizado_en      DateTime @updatedAt

  categoria_padre Categoria?           @relation("JerarquiaCategorias", fields: [categoria_padre_id], references: [id])
  subcategorias   Categoria[]          @relation("JerarquiaCategorias")
  productos       Producto[]
  descuentos      DescuentoCategoria[]

  @@map("categorias")
}

enum TipoProducto {
  SIMPLE
  COMBO
  SERVICIO
}

enum ModoVenta {
  PERMANENTE
  RANGO_FECHAS
  FECHA_HORA
  CUPO_FIJO
  MIXTO
}

enum CanalVenta {
  AMBOS
  ECOMMERCE
  POS
}

model Producto {
  id                 BigInt       @id @default(autoincrement())
  public_id          String       @unique @default(uuid()) @db.Uuid
  categoria_id       BigInt
  marca_id           BigInt?
  sku                String       @unique @db.VarChar(255)
  nombre             String       @db.VarChar(220)
  descripcion        String?      @db.Text
  naturaleza         String?      @db.VarChar(80)
  tipo_producto      TipoProducto @default(SIMPLE)
  unidad_medida      String       @default("UNIDAD") @db.VarChar(40)
  atributos          Json         @default("{}") @db.JsonB
  precio_base        Decimal      @default(0) @db.Decimal(14, 2)
  costo_promedio     Decimal      @default(0) @db.Decimal(14, 2)
  precio_promocional Decimal?     @db.Decimal(14, 2)
  opciones_variantes Json         @default("[]") @db.JsonB
  activo             Boolean      @default(true)
  modo_venta         ModoVenta    @default(PERMANENTE)
  vigencia_inicio    DateTime?    @db.Timestamptz(3)
  vigencia_fin       DateTime?    @db.Timestamptz(3)
  cupo_maximo        Int?
  cupo_usado         Int          @default(0)
  dias_semana        Int[]        @default([])
  canal_venta        CanalVenta   @default(AMBOS)
  creado_en          DateTime     @default(now())
  actualizado_en     DateTime     @updatedAt

  categoria             Categoria               @relation(fields: [categoria_id], references: [id])
  marca                 Marca?                  @relation(fields: [marca_id], references: [id])
  imagenes              ProductoImagen[]
  variantes             Variante[]
  Inventario            Inventario[]
  MovimientosInventario MovimientosInventario[]
  CompraDetalle         CompraDetalle[]
  VentaDetalle          VentaDetalle[]
  descuentos            DescuentoProducto[]
  componentes_combo     ProductoComponente[]    @relation("ComboPadre")
  usado_en_combos       ProductoComponente[]    @relation("ComponenteHijo")
  pedidoDetalles        PedidoDetalle[]
  devolucionDetalles    DevolucionDetalle[]

  @@index([activo, tipo_producto, vigencia_fin])
  @@map("productos")
}

model ProductoImagen {
  id                BigInt   @id @default(autoincrement())
  producto_id       BigInt
  url               String   @db.Text
  texto_alternativo String?  @db.VarChar(255)
  orden             Int      @default(0)
  es_principal      Boolean  @default(false)
  activo            Boolean  @default(true)
  creado_en         DateTime @default(now())
  actualizado_en    DateTime @updatedAt

  producto Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, url])
  @@map("producto_imagenes")
}

model Variante {
  id                   BigInt   @id @default(autoincrement())
  producto_id          BigInt
  nombre               String   @db.VarChar(255)
  sku_base             String   @unique @db.VarChar(255)
  codigo_barras        String?  @unique @db.VarChar(255)
  precio_unitario      Decimal  @default(0) @db.Decimal(14, 2)
  costo_promedio       Decimal  @default(0) @db.Decimal(14, 2)
  precio_promocional   Decimal? @db.Decimal(14, 2)
  combinacion_opciones Json     @default("{}") @db.JsonB
  imagen_url           String?  @db.Text
  activo               Boolean  @default(true)
  creado_en            DateTime @default(now())
  actualizado_en       DateTime @updatedAt

  producto              Producto                @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  empaques              Empaque[]
  Inventario            Inventario[]
  MovimientosInventario MovimientosInventario[]
  CompraDetalle         CompraDetalle[]
  VentaDetalle          VentaDetalle[]
  descuentos            DescuentoVariante[]
  usado_en_combos       ProductoComponente[]
  pedidoDetalles        PedidoDetalle[]

  @@unique([producto_id, nombre])
  @@map("variantes")
}

model Empaque {
  id                     BigInt   @id @default(autoincrement())
  variante_id            BigInt
  nombre                 String   @db.VarChar(255)
  sku                    String   @unique @db.VarChar(255)
  codigo_barras          String?  @unique @db.VarChar(255)
  multiplicador_unidades Int      @default(1)
  costo_promedio         Decimal  @default(0) @db.Decimal(14, 2)
  precio                 Decimal  @db.Decimal(14, 2)
  precio_promocional     Decimal? @db.Decimal(14, 2)
  activo                 Boolean  @default(true)
  creado_en              DateTime @default(now())
  actualizado_en         DateTime @updatedAt

  variante        Variante             @relation(fields: [variante_id], references: [id], onDelete: Cascade)
  CompraDetalle   CompraDetalle[]
  VentaDetalle    VentaDetalle[]
  descuentos      DescuentoEmpaque[]
  usado_en_combos ProductoComponente[]
  pedidoDetalles  PedidoDetalle[]

  @@unique([variante_id, nombre])
  @@map("empaques")
}

model ProductoComponente {
  id                 BigInt   @id @default(autoincrement())
  combo_producto_id  BigInt
  componente_prod_id BigInt
  variante_id        BigInt?
  empaque_id         BigInt?
  cantidad           Int      @default(1)
  creado_en          DateTime @default(now())

  combo_producto      Producto  @relation("ComboPadre", fields: [combo_producto_id], references: [id], onDelete: Cascade)
  componente_producto Producto  @relation("ComponenteHijo", fields: [componente_prod_id], references: [id], onDelete: Restrict)
  variante            Variante? @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  empaque             Empaque?  @relation(fields: [empaque_id], references: [id], onDelete: Restrict)

  @@map("producto_componentes")
}

model Inventario {
  id                  BigInt   @id @default(autoincrement())
  producto_id         BigInt
  variante_id         BigInt?
  cantidad_disponible Int      @default(0)
  reservado           Int      @default(0)
  stock_minimo        Int      @default(5)
  ubicacion           String?  @db.VarChar(120)
  creado_en           DateTime @default(now())
  actualizado_en      DateTime @updatedAt

  producto Producto                   @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  variante Variante?                  @relation(fields: [variante_id], references: [id], onDelete: Cascade)
  reservas ReservaInventarioDetalle[]

  // `ubicacion` remains descriptive metadata; stock is keyed only by product and variant.
  // The migration creates this PostgreSQL index with NULLS NOT DISTINCT so base products
  // (whose variante_id is NULL) also have exactly one stock row.
  @@unique([producto_id, variante_id])
  @@map("inventario")
}

model MovimientosInventario {
  id                    BigInt   @id @default(autoincrement())
  producto_id           BigInt
  variante_id           BigInt?
  tipo_movimiento       String
  cantidad              Int
  motivo                String?
  usuario_id            BigInt?
  tipo_documento_origen String?
  documento_origen_id   BigInt?
  creado_en             DateTime @default(now())

  producto Producto  @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  variante Variante? @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  usuario  Usuario?  @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([producto_id])
  @@index([variante_id])
  @@index([documento_origen_id])
  @@index([creado_en])
  @@map("movimientos_inventario")
}

model Proveedor {
  id             BigInt   @id @default(autoincrement())
  nombre         String   @db.VarChar(255) // Nombre de la empresa o persona
  contacto       String?  @db.VarChar(255) // Persona de contacto
  telefono       String?  @db.VarChar(50)
  direccion      String?  @db.Text
  email          String?  @db.VarChar(255)
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id               BigInt   @id @default(autoincrement())
  public_id        String?  @unique @default(uuid()) @db.Uuid
  proveedor_id     BigInt?
  usuario_id       BigInt?
  numero_nota      String   @default("S/N") @db.VarChar(100)
  fecha            DateTime @default(now())
  costo_transporte Decimal  @default(0) @db.Decimal(14, 2)
  subtotal         Decimal  @default(0) @db.Decimal(14, 2)
  total            Decimal  @default(0) @db.Decimal(14, 2)
  estado           String   @default("BORRADOR") @db.VarChar(50)
  notas            String?  @db.Text
  creado_en        DateTime @default(now())
  actualizado_en   DateTime @default(now()) @updatedAt

  proveedor Proveedor?      @relation(fields: [proveedor_id], references: [id], onDelete: Restrict)
  usuario   Usuario?        @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  detalles  CompraDetalle[]

  @@index([proveedor_id])
  @@index([estado])
  @@map("compras")
}

model CompraDetalle {
  id                  BigInt  @id @default(autoincrement())
  compra_id           BigInt
  producto_id         BigInt
  variante_id         BigInt?
  empaque_id          BigInt?
  cantidad_solicitada Int     @default(1)
  cantidad_recibida   Int     @default(0)
  precio_costo        Decimal @default(0) @db.Decimal(14, 2)
  subtotal            Decimal @default(0) @db.Decimal(14, 2)

  compra   Compra    @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  producto Producto  @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  variante Variante? @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  empaque  Empaque?  @relation(fields: [empaque_id], references: [id], onDelete: Restrict)

  @@index([compra_id])
  @@index([producto_id])
  @@map("compra_detalles")
}

model Cliente {
  id             BigInt   @id @default(autoincrement())
  nombre         String   @default("Cliente Generico") @db.VarChar(255)
  documento_id   String?  @unique @db.VarChar(50)
  email          String?  @db.VarChar(255)
  telefono       String?  @db.VarChar(50)
  direccion      String?  @db.Text
  password_hash  String?  @db.Text
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  ventas                 Venta[]
  usosDescuento          DescuentoUso[]
  direcciones            Direccion[]
  resetTokens            ClienteResetToken[]
  pedidos                Pedido[]
  historialEstadoCliente PedidoHistorialEstado[] @relation("PedidoHistorialCambiadoPorCliente")
  devoluciones           Devolucion[]
  bitacoraEventos        Bitacora[]              @relation("BitacoraCliente")

  @@map("clientes")
}

model Direccion {
  id                     BigInt   @id @default(autoincrement())
  cliente_id             BigInt
  alias                  String   @db.VarChar(100)
  destinatario_nombre    String   @db.VarChar(255)
  destinatario_apellidos String   @db.VarChar(255)
  direccion_completa     String   @db.Text
  ciudad                 String   @db.VarChar(100)
  telefono               String   @db.VarChar(50)
  referencia             String?  @db.Text
  es_principal           Boolean  @default(false)
  creado_en              DateTime @default(now())
  actualizado_en         DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@map("direcciones")
}

model ClienteResetToken {
  id         BigInt   @id @default(autoincrement())
  cliente_id BigInt
  token_hash String   @unique @db.VarChar(64)
  expira_en  DateTime
  usado      Boolean  @default(false)
  creado_en  DateTime @default(now())

  cliente Cliente @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@map("cliente_reset_tokens")
}

model Venta {
  id               BigInt   @id @default(autoincrement())
  cliente_id       BigInt?
  usuario_id       BigInt
  caja_id          BigInt?
  numero_ticket    String   @unique @default(cuid()) @db.VarChar(100)
  idempotency_key  String?  @db.VarChar(100)
  estado           String   @default("COMPLETADA") @db.VarChar(50) // COMPLETADA, ANULADA
  motivo_anulacion String?  @db.Text
  total            Decimal  @default(0) @db.Decimal(14, 2)
  descuento_total  Decimal  @default(0) @db.Decimal(14, 2)
  codigo_cupon     String?  @db.VarChar(100)
  metodo_pago      String   @default("EFECTIVO") @db.VarChar(50)
  canal_venta      String   @default("PRESENCIAL") @db.VarChar(20) // PRESENCIAL, ONLINE
  monto_pagado     Decimal  @default(0) @db.Decimal(14, 2)
  vuelto           Decimal  @default(0) @db.Decimal(14, 2)
  creado_en        DateTime @default(now())
  actualizado_en   DateTime @updatedAt

  cliente            Cliente?           @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  usuario            Usuario            @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  caja               Caja?              @relation(fields: [caja_id], references: [id], onDelete: SetNull)
  detalles           VentaDetalle[]
  usosDescuento      DescuentoUso[]
  reserva_inventario ReservaInventario?

  @@index([estado, creado_en])
  @@unique([usuario_id, idempotency_key])
  @@map("ventas")
}

model VentaDetalle {
  id                       BigInt  @id @default(autoincrement())
  venta_id                 BigInt
  producto_id              BigInt
  variante_id              BigInt?
  empaque_id               BigInt?
  cantidad                 Int
  precio_unitario          Decimal @db.Decimal(14, 2)
  precio_unitario_catalogo Decimal @default(0) @db.Decimal(14, 2)
  aprobado_por_usuario_id  BigInt?
  motivo_ajuste            String? @db.Text
  subtotal                 Decimal @db.Decimal(14, 2)

  venta                Venta     @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  producto             Producto  @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  variante             Variante? @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  empaque              Empaque?  @relation(fields: [empaque_id], references: [id], onDelete: Restrict)
  aprobado_por_usuario Usuario?  @relation("VentaDetalleAprobadoPor", fields: [aprobado_por_usuario_id], references: [id], onDelete: Restrict)

  @@index([venta_id])
  @@index([producto_id])
  @@map("venta_detalles")
}

model ReservaInventario {
  id             BigInt   @id @default(autoincrement())
  public_id      String   @unique @default(uuid()) @db.Uuid
  usuario_id     BigInt
  venta_id       BigInt?  @unique
  estado         String   @default("ACTIVA") @db.VarChar(20) // ACTIVA, CONSUMIDA, LIBERADA, EXPIRADA
  expira_en      DateTime
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  usuario  Usuario                    @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  venta    Venta?                     @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  detalles ReservaInventarioDetalle[]
  pedido   Pedido?
  pagosQr  PagoQR[]

  @@index([estado, expira_en])
  @@map("reservas_inventario")
}

model ReservaInventarioDetalle {
  id            BigInt @id @default(autoincrement())
  reserva_id    BigInt
  inventario_id BigInt
  cantidad      Int

  reserva    ReservaInventario @relation(fields: [reserva_id], references: [id], onDelete: Cascade)
  inventario Inventario        @relation(fields: [inventario_id], references: [id], onDelete: Restrict)

  @@unique([reserva_id, inventario_id])
  @@index([inventario_id])
  @@map("reservas_inventario_detalles")
}

model Pedido {
  id                       BigInt   @id @default(autoincrement())
  numero_pedido            String   @unique @default(cuid()) @db.VarChar(100)
  cliente_id               BigInt?
  reserva_id               BigInt?  @unique
  preparador_id            BigInt?
  repartidor_id            BigInt?
  estado                   String   @default("PENDIENTE_PAGO") @db.VarChar(50)
  direccion_envio_snapshot Json     @db.JsonB
  costo_envio              Decimal  @default(0) @db.Decimal(14, 2)
  subtotal                 Decimal  @default(0) @db.Decimal(14, 2)
  descuento_total          Decimal  @default(0) @db.Decimal(14, 2)
  total                    Decimal  @default(0) @db.Decimal(14, 2)
  metodo_pago              String   @default("QR") @db.VarChar(50)
  notas                    String?  @db.Text
  creado_en                DateTime @default(now())
  actualizado_en           DateTime @updatedAt

  cliente         Cliente?                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  reserva         ReservaInventario?      @relation(fields: [reserva_id], references: [id], onDelete: SetNull)
  preparador      Usuario?                @relation("PedidoPreparador", fields: [preparador_id], references: [id], onDelete: SetNull)
  repartidor      Usuario?                @relation("PedidoRepartidor", fields: [repartidor_id], references: [id], onDelete: SetNull)
  detalles        PedidoDetalle[]
  historialEstado PedidoHistorialEstado[]
  pagoQr          PagoQR?
  devoluciones    Devolucion[]

  @@index([cliente_id])
  @@index([estado, creado_en])
  @@map("pedidos")
}

model PedidoDetalle {
  id              BigInt  @id @default(autoincrement())
  pedido_id       BigInt
  producto_id     BigInt
  variante_id     BigInt?
  empaque_id      BigInt?
  nombre_producto String  @db.VarChar(255)
  sku             String? @db.VarChar(100)
  precio_unitario Decimal @db.Decimal(14, 2)
  cantidad        Int
  subtotal        Decimal @db.Decimal(14, 2)
  imagen_url      String? @db.Text

  pedido             Pedido              @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto           Producto            @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  variante           Variante?           @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  empaque            Empaque?            @relation(fields: [empaque_id], references: [id], onDelete: Restrict)
  devolucionDetalles DevolucionDetalle[]

  @@index([pedido_id])
  @@index([producto_id])
  @@map("pedido_detalles")
}

model PedidoHistorialEstado {
  id                      BigInt   @id @default(autoincrement())
  pedido_id               BigInt
  estado_anterior         String?  @db.VarChar(50)
  estado_nuevo            String   @db.VarChar(50)
  cambiado_por_usuario_id BigInt?
  cambiado_por_cliente_id BigInt?
  motivo                  String?  @db.Text
  creado_en               DateTime @default(now())

  pedido               Pedido   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  cambiado_por_usuario Usuario? @relation("PedidoHistorialCambiadoPorUsuario", fields: [cambiado_por_usuario_id], references: [id], onDelete: Restrict)
  cambiado_por_cliente Cliente? @relation("PedidoHistorialCambiadoPorCliente", fields: [cambiado_por_cliente_id], references: [id], onDelete: Restrict)

  @@index([pedido_id])
  @@map("pedido_historial_estados")
}

model PagoQR {
  id              BigInt    @id @default(autoincrement())
  public_id       String    @unique @default(uuid()) @db.Uuid
  pedido_id       BigInt    @unique
  reserva_id      BigInt?
  idempotency_key String    @unique @db.VarChar(100)
  qr_contenido    String    @db.Text
  monto           Decimal   @db.Decimal(14, 2)
  moneda          String    @default("BOB") @db.VarChar(10)
  estado          String    @default("PENDIENTE") @db.VarChar(30)
  referencia_bisa String?   @unique @db.VarChar(100)
  expira_en       DateTime
  confirmado_en   DateTime?
  creado_en       DateTime  @default(now())
  actualizado_en  DateTime  @updatedAt

  pedido  Pedido             @relation(fields: [pedido_id], references: [id], onDelete: Restrict)
  reserva ReservaInventario? @relation(fields: [reserva_id], references: [id], onDelete: SetNull)

  @@index([estado, expira_en])
  @@map("pagos_qr")
}

model PagoWebhookLog {
  id            BigInt   @id @default(autoincrement())
  event_id      String?  @db.VarChar(100)
  origen        String   @default("BANCO_BISA") @db.VarChar(50)
  payload       Json     @db.JsonB
  headers       Json?    @db.JsonB
  procesado     Boolean  @default(false)
  error_mensaje String?  @db.Text
  creado_en     DateTime @default(now())

  @@index([event_id])
  @@index([creado_en])
  @@map("pagos_webhook_logs")
}

model Devolucion {
  id                      BigInt    @id @default(autoincrement())
  public_id               String    @unique @default(uuid()) @db.Uuid
  pedido_id               BigInt
  cliente_id              BigInt
  estado                  String    @default("SOLICITADA") @db.VarChar(30)
  motivo                  String    @db.Text
  resolucion              String?   @db.VarChar(50)
  destino_fisico          String?   @db.VarChar(50)
  monto_reembolso         Decimal?  @db.Decimal(14, 2)
  notas_evaluacion        String?   @db.Text
  evaluado_por_usuario_id BigInt?
  evaluado_en             DateTime?
  creado_en               DateTime  @default(now())
  actualizado_en          DateTime  @updatedAt

  pedido               Pedido              @relation(fields: [pedido_id], references: [id], onDelete: Restrict)
  cliente              Cliente             @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  evaluado_por_usuario Usuario?            @relation("DevolucionEvaluadaPorUsuario", fields: [evaluado_por_usuario_id], references: [id], onDelete: SetNull)
  detalles             DevolucionDetalle[]

  @@index([pedido_id])
  @@index([cliente_id])
  @@index([estado])
  @@map("devoluciones")
}

model DevolucionDetalle {
  id                BigInt  @id @default(autoincrement())
  devolucion_id     BigInt
  pedido_detalle_id BigInt
  producto_id       BigInt
  cantidad          Int
  motivo_item       String? @db.Text

  devolucion     Devolucion    @relation(fields: [devolucion_id], references: [id], onDelete: Cascade)
  pedido_detalle PedidoDetalle @relation(fields: [pedido_detalle_id], references: [id], onDelete: Restrict)
  producto       Producto      @relation(fields: [producto_id], references: [id], onDelete: Restrict)

  @@index([devolucion_id])
  @@index([pedido_detalle_id])
  @@map("devolucion_detalles")
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
  MONTO_FIJO_POR_UNIDAD
  COMBO
  LLEVA_X_PAGA_Y
}

enum AlcanceDescuento {
  GLOBAL
  CATEGORIA
  PRODUCTO
  VARIANTE
  EMPAQUE
}

enum CanalDescuento {
  POS
  ECOMMERCE
  TODOS
}

model Descuento {
  id                  BigInt           @id @default(autoincrement())
  nombre              String           @db.VarChar(255)
  descripcion         String?          @db.Text
  codigo_cupon        String?          @unique @db.VarChar(100)
  tipo                TipoDescuento    @default(PORCENTAJE)
  valor               Decimal          @default(0) @db.Decimal(14, 2)
  max_monto_descuento Decimal?         @db.Decimal(14, 2)
  alcance             AlcanceDescuento @default(GLOBAL)
  canal               CanalDescuento   @default(TODOS)

  // Para Combos y NxF (ej: 2x1 -> lleva 2, paga 1)
  cantidad_requerida Int @default(1)
  cantidad_paga      Int @default(1)

  monto_minimo_compra     Decimal? @db.Decimal(14, 2)
  limite_usos             Int?
  limite_usos_por_cliente Int?     @default(1)
  usos_actuales           Int      @default(0)

  prioridad Int @default(0)

  fecha_inicio DateTime
  fecha_fin    DateTime
  activo       Boolean  @default(true)

  // Programación semanal: días (0=Domingo..6=Sábado, [] = todos) y ventana horaria "HH:MM"
  dias_semana Int[]   @default([])
  hora_inicio String? @db.VarChar(5)
  hora_fin    String? @db.VarChar(5)

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  productos  DescuentoProducto[]
  variantes  DescuentoVariante[]
  empaques   DescuentoEmpaque[]
  categorias DescuentoCategoria[]
  usos       DescuentoUso[]

  @@map("descuentos")
}

model DescuentoProducto {
  id           BigInt @id @default(autoincrement())
  descuento_id BigInt
  producto_id  BigInt

  descuento Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  producto  Producto  @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([descuento_id, producto_id])
  @@map("descuento_productos")
}

model DescuentoVariante {
  id           BigInt @id @default(autoincrement())
  descuento_id BigInt
  variante_id  BigInt

  descuento Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  variante  Variante  @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@unique([descuento_id, variante_id])
  @@map("descuento_variantes")
}

model DescuentoEmpaque {
  id           BigInt @id @default(autoincrement())
  descuento_id BigInt
  empaque_id   BigInt

  descuento Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  empaque   Empaque   @relation(fields: [empaque_id], references: [id], onDelete: Cascade)

  @@unique([descuento_id, empaque_id])
  @@map("descuento_empaques")
}

model DescuentoCategoria {
  id           BigInt @id @default(autoincrement())
  descuento_id BigInt
  categoria_id BigInt

  descuento Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  @@unique([descuento_id, categoria_id])
  @@map("descuento_categorias")
}

model DescuentoUso {
  id               BigInt   @id @default(autoincrement())
  descuento_id     BigInt
  venta_id         BigInt
  cliente_id       BigInt?
  monto_descontado Decimal  @db.Decimal(14, 2)
  creado_en        DateTime @default(now())

  descuento Descuento @relation(fields: [descuento_id], references: [id], onDelete: Cascade)
  venta     Venta     @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  cliente   Cliente?  @relation(fields: [cliente_id], references: [id], onDelete: SetNull)

  @@index([descuento_id, cliente_id])
  @@map("descuento_usos")
}

// ==========================================
// MÓDULO FINANZAS Y ARQUEO DE CAJA
// ==========================================

model Caja {
  id                BigInt    @id @default(autoincrement())
  usuario_id        BigInt // Cajero responsable
  fecha_apertura    DateTime  @default(now())
  fecha_cierre      DateTime?
  monto_apertura    Decimal   @default(0) @db.Decimal(14, 2)
  monto_cierre_esp  Decimal?  @db.Decimal(14, 2) // Lo que debería haber (Esperado)
  monto_cierre_real Decimal?  @db.Decimal(14, 2) // Lo que el cajero contó (Real)
  diferencia        Decimal?  @db.Decimal(14, 2) // Sobrante (+) o Faltante (-)
  estado            String    @default("ABIERTA") @db.VarChar(50) // ABIERTA, CERRADA
  observaciones     String?   @db.Text
  creado_en         DateTime  @default(now())
  actualizado_en    DateTime  @updatedAt

  usuario     Usuario          @relation("CajaUsuario", fields: [usuario_id], references: [id], onDelete: Restrict)
  movimientos MovimientoCaja[]
  ventas      Venta[] // Ventas realizadas en este turno de caja

  @@index([estado, fecha_apertura])
  @@map("cajas")
}

model MovimientoCaja {
  id              BigInt   @id @default(autoincrement())
  caja_id         BigInt
  usuario_id      BigInt // Quien registra el movimiento
  tipo_movimiento String   @db.VarChar(50) // INGRESO, EGRESO
  concepto        String   @db.VarChar(255) // Ej: "Pago pasajes", "Compra agua", "Ingreso venta manual"
  monto           Decimal  @db.Decimal(14, 2)
  metodo_pago     String   @default("EFECTIVO") @db.VarChar(50) // EFECTIVO, QR, TARJETA, TRANSFERENCIA
  comprobante_url String?  @db.Text // Foto del recibito si compraron algo
  referencia_id   String?  @db.VarChar(100) // ID de Venta si es un ingreso automático por venta
  creado_en       DateTime @default(now())

  caja    Caja    @relation(fields: [caja_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation("MovimientoCajaUsuario", fields: [usuario_id], references: [id], onDelete: Restrict)

  @@index([caja_id, tipo_movimiento])
  @@map("movimientos_caja")
}

model GastoOperativo {
  id              BigInt   @id @default(autoincrement())
  usuario_id      BigInt
  categoria       String   @db.VarChar(100) // ALQUILER, SERVICIOS, SUELDOS, MARKETING, OTROS
  descripcion     String   @db.VarChar(255)
  monto           Decimal  @db.Decimal(14, 2)
  fecha_gasto     DateTime @default(now())
  comprobante_url String?  @db.Text
  creado_en       DateTime @default(now())
  actualizado_en  DateTime @updatedAt

  usuario Usuario @relation("GastoOperativoUsuario", fields: [usuario_id], references: [id], onDelete: Restrict)

  @@index([categoria, fecha_gasto])
  @@map("gastos_operativos")
}
